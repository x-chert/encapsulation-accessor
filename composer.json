{
	"name": "xchert/encapsulation-accessor",
	"description": "Accessors to use xchert/encapsulation in combination with xchert/property-access",
	"type": "library",
	"keywords": [
		"property-access",
		"encapsulation",
		"accessor",
		"object-access",
		"container-accessor"
	],
	"license": "MIT",
	"authors": [
		{
			"name": "Dustin Simon"
		}
	],
	"support": {
		"issues": "https://github.com/x-chert/encapsulation-accessor/issues",
		"source": "https://github.com/x-chert/encapsulation-accessor"
	},
	"autoload": {
		"psr-4": {
			"Xchert\\PropertyAccess\\": "src/"
		},
		"exclude-from-classmap": [
			"src/Test/"
		]
	},
	"require": {
		"php": "^8.3",
		"xchert/util": "~1.0",
		"xchert/encapsulation": "~1.0",
		"xchert/property-access": "~1.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.3"
	}
}
